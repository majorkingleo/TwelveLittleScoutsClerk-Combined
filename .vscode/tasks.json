{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build project (Maven)",
			"type": "shell",
			"command": "bash -c 'mvn clean compile'",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				{
					"owner": "java",
					"fileLocation": "absolute",
					"pattern": {
						"regexp": "^\\[ERROR\\]\\s+(/.+\\.java):\\[(\\d+),(\\d+)\\]\\s+(.+)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"message": 4
					}
				}
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Package project (Maven)",
			"type": "shell",
			"command": "bash -c 'mvn clean package -Dmaven.test.skip=true'",
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Run tests (Maven)",
			"type": "shell",
			"command": "bash -c 'mvn clean test'",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": [
				{
					"owner": "java",
					"fileLocation": "absolute",
					"pattern": {
						"regexp": "^\\[ERROR\\]\\s+(/.+\\.java):\\[(\\d+),(\\d+)\\]\\s+(.+)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"message": 4
					}
				}
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Clean project (Maven)",
			"type": "shell",
			"command": "bash -c 'mvn clean'",
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Download JDKs (for distribution)",
			"type": "shell",
			"command": "bash scripts/download-jdks.sh",
			"options": {
				"cwd": "${workspaceFolder}/TwelveLittleScoutsClerk"
			},
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Build Distribution (Linux + Windows ZIP)",
			"type": "shell",
			"command": "bash -c 'mvn clean package -Dmaven.test.skip=true && cd TwelveLittleScoutsClerk && bash scripts/build-dist.sh'",
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "local install",
			"type": "shell",
			"command": "bash -c 'cd TwelveLittleScoutsClerk && bash scripts/install-desktop-kde.sh --user-only'",
			"group": "build",
			"problemMatcher": [],
			"dependsOn": ["Package project (Maven)"],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		}		
	]
}
